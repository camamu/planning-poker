{
  "name": "@pp/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain tests/use-cases",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "migrate:up": "tsx src/infrastructure/persistence/postgres/migrate.ts up",
    "migrate:down": "tsx src/infrastructure/persistence/postgres/migrate.ts down"
  },
  "dependencies": {
    "fastify": "^5.11.2",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.8"
  }
}
