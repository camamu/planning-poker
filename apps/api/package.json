{
  "name": "@pp/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/domain tests/use-cases",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "migrate:up": "tsx src/infrastructure/persistence/postgres/migrate.ts up",
    "migrate:down": "tsx src/infrastructure/persistence/postgres/migrate.ts down"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@pp/contracts": "workspace:*",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
